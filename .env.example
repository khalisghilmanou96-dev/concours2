# Stripe — secrets serveur uniquement (jamais de préfixe VITE_)
STRIPE_SECRET_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# URL du site
APP_URL=http://localhost:5173
PORT=4242

# Formspree : identifiant situé après /f/ dans l'URL du formulaire
FORMSPREE_FORM_ID=xxxxxxxxx
TICKET_PRICE_EUR=10
MAX_TICKETS=500

# Render : si vous attachez un Persistent Disk monté sur /var/data
# DATA_FILE=/var/data/concours-store.json
